      "parameters": {
        "jsCode": "const NORMALIZE_NODE = 'Normalize form';\nconst CONTACT_NODE = 'Create or update a contact';\nconst DEAL_NODE = 'Create a deal';\n\nlet lead = $json.lead || {};\n\nif (!lead || Object.keys(lead).length === 0) {\n  try {\n    const n = $node[NORMALIZE_NODE];\n    if (n?.item?.json?.lead) {\n      lead = n.item.json.lead;\n    }\n  } catch (e) {\n    lead = {};\n  }\n}\n\nlet contactId = null;\ntry {\n  const c = $node[CONTACT_NODE]?.item?.json;\n  if (c?.vid) {\n    contactId = c.vid;\n  }\n} catch (e) {\n  contactId = null;\n}\n\nlet dealId = null;\ntry {\n  const d = $node[DEAL_NODE]?.item?.json;\n  if (d?.dealId) {\n    dealId = d.dealId;\n  } else if (d?.id) {\n    dealId = d.id;\n  }\n} catch (e) {\n  dealId = null;\n}\n\nlet step = $json.step || 'unknown';\nlet status = $json.status || 'unknown';\n\nconst execErr = $execution.error;\nconst localErr = $json.error;\nconst hasError = !!(execErr || localErr);\n\nif (hasError) {\n  step = 'error';\n  status = 'error';\n}\n\nlet error_message = '';\nif (hasError) {\n  error_message =\n    (localErr?.message) ||\n    (execErr?.message) ||\n    (typeof execErr === 'string' ? execErr : '') ||\n    '';\n}\n\nconst log = {\n  email: lead.email || null,\n  company: lead.company || null,\n  priority: lead.priority || null,\n  classification: lead.classification || null,\n  source: lead.source || null,\n  budget: lead.budget || null,\n  urgency: lead.urgency || null,\n  use_case: lead.use_case || null,\n\n  contact_id: contactId,\n  deal_id: dealId,\n\n  step,\n  status,\n  error_message,\n  raw_execution: $execution.id,\n};\n\nreturn [{ json: log }];\n"
      },
