      "parameters": {
        "jsCode": "const root = $json.body?.data || $json.data || {};\nconst fields = Array.isArray(root.fields) ? root.fields : [];\n\nconst byKey = (k) => fields.find(f => f.key === k);\n\nfunction valueAsText(f) {\n  if (!f) return null;\n  const t = f.type;\n  const v = f.value;\n  if (v == null) return null;\n\n  if ((t === 'DROPDOWN' || t === 'CHECKBOXES') && Array.isArray(v)) {\n    const idToText = new Map((f.options || []).map(o => [o.id, o.text]));\n    const texts = v.map(id => idToText.get(id)).filter(Boolean);\n    return texts.length ? (t === 'DROPDOWN' ? texts[0] : texts) : null;\n  }\n  return v;\n}\n\nconst K = {\n  full_name:   'question_bdvxag',\n  email:       'question_AvyLk0',\n  company:     'question_B70kv5',\n  website:     'question_kEv6L1',\n  company_size:'question_vYKyRv',\n  role:        'question_K1klXA',\n  country:     'question_LpkW8j',\n  use_case:    'question_pOvBgq',\n  budget:      'question_1V67jQ',\n  urgency:     'question_MRMz0p',\n  source:      'question_JzMAy4',\n  consentFlag: 'question_gGvMBl_92eda117-0cd9-4ade-ab4f-d22c843add98',\n  utm_source:  'question_yYz9OB_8926be13-ffe9-4017-b326-1fad31176e5b',\n  utm_medium:  'question_yYz9OB_54850bb1-5654-4107-81a6-6d6737a46db7',\n  utm_campaign:'question_yYz9OB_ee3c11e9-f238-42b1-b1c9-0b02eb582572',\n};\n\nconst name      = valueAsText(byKey(K.full_name)) || '';\nconst emailRaw  = valueAsText(byKey(K.email)) || '';\nconst email     = String(emailRaw).trim().toLowerCase();\nconst company   = valueAsText(byKey(K.company)) || '';\nconst website   = valueAsText(byKey(K.website)) || '';\nconst role      = valueAsText(byKey(K.role)) || '';\nconst country   = valueAsText(byKey(K.country)) || '';\nconst use_case  = valueAsText(byKey(K.use_case)) || '';\nconst budget    = Number(valueAsText(byKey(K.budget)) || 0);\nconst urgency   = (valueAsText(byKey(K.urgency)) || '').toString().trim();\nconst source    = valueAsText(byKey(K.source)) || '';\nconst consent   = !!valueAsText(byKey(K.consentFlag));\nconst utm_source   = valueAsText(byKey(K.utm_source)) || null;\nconst utm_medium   = valueAsText(byKey(K.utm_medium)) || null;\nconst utm_campaign = valueAsText(byKey(K.utm_campaign)) || null;\nconst company_size = valueAsText(byKey(K.company_size)) || 0;\n\nconst domain = email.includes('@') ? email.split('@')[1] : '';\nconst freeDomains = ['gmail.com','yahoo.com','outlook.com','mail.ru','yandex.ru'];\nconst tempDomains = ['tempmail.com','10minutemail.com'];\n\nlet classification = 'valid';\nlet priority = 'normal';\n\n// Спам\nif (!email || tempDomains.includes(domain)) {\n  classification = 'spam';\n} else {\n  const u = urgency.toLowerCase();\n  const urgencyIsHighOrMedium = (u === 'high' || u === 'medium');\n\n  const businessStrong =\n    budget >= 1000 &&\n    company_size >= 50 &&\n    !!website &&\n    !freeDomains.includes(domain);\n\n  if (businessStrong && urgencyIsHighOrMedium) {\n    priority = 'high';\n  } else {\n    priority = 'normal';\n  }\n}\n\nconst submitted_at = root.createdAt || $json.body?.createdAt || new Date().toISOString();\n\nreturn [{\n  json: {\n    lead: {\n      name,\n      email,\n      company,\n      website,\n      company_size,\n      role,\n      country,\n      use_case,\n      budget,\n      urgency,\n      source,\n      utm_source,\n      utm_medium,\n      utm_campaign,\n      consent,\n      priority,\n      classification,\n      submitted_at,\n      form: {\n        form_id: root.formId || null,\n        response_id: root.responseId || root.submissionId || null,\n        form_name: root.formName || null\n      }\n    },\n    _raw: {\n      headers: $json.headers,\n      webhookUrl: $json.webhookUrl,\n      executionMode: $json.executionMode\n    }\n  }\n}];\n"
