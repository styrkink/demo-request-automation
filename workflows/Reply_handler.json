    {
      "parameters": {
        "jsCode": "const LOG_NODE = 'Read log by email';\n\nlet base = {};\ntry {\n  const item = $items(LOG_NODE, 0, 0)[0];  // первый item первого запуска\n  base = (item && item.json) ? item.json : {};\n} catch (e) {\n  base = {};\n}\n\n// 2. step / status — приоритет у значений из Set : log proposal\nlet step = $json.step || base.step || 'proposal_sent';\nlet status = $json.status || base.status || 'ok';\n\n// 3. Ошибка (если нода вызвана из Error workflow)\nconst execErr = $execution.error;\nconst localErr = $json.error;\nconst hasError = !!(execErr || localErr);\n\nlet error_message = '';\n\nif (hasError) {\n  step = 'error';\n  status = 'error';\n  error_message =\n    (localErr && localErr.message) ||\n    (execErr && execErr.message) ||\n    (typeof execErr === 'string' ? execErr : '') ||\n    '';\n}\n\n// 4. Собираем финальный лог\nconst log = {\n  email:          base.email || null,\n  company:        base.company || null,\n  priority:       base.priority || null,\n  classification: base.classification || null,\n  source:         base.source || null,\n  budget:         base.budget || null,\n  urgency:        base.urgency || null,\n  use_case:       base.use_case || null,\n\n  contact_id: base.contact_id ?? base.contactId ?? null,\n  deal_id:    base.deal_id    ?? base.dealId    ?? null,\n\n  step,\n  status,\n  error_message,\n  raw_execution: $execution.id,\n};\n\nreturn [{ json: log }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
