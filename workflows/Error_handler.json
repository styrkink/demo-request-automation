      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "// 1. Базовые объекты из Error Trigger\nconst exec = $json.execution || {};\nconst wf   = $json.workflow  || {};\nconst err  = $json.error     || {};\n\n// 2. Пытаемся вытащить хоть какой-то контекст\n// Сейчас оставляем null — потом можно будет донастроить вытаскивание email/lead.\nlet email          = null;\nlet company        = null;\nlet priority       = null;\nlet classification = null;\nlet source         = null;\nlet budget         = null;\nlet urgency        = null;\nlet use_case       = null;\nlet contact_id     = null;\nlet deal_id        = null;\n\n// 3. Собираем человекочитаемое сообщение об ошибке\nconst workflowName = wf.name || 'unknown workflow';\nconst lastNode     = exec.lastNodeExecuted || 'unknown node';\nconst baseMessage  = err.message || 'Unknown error';\n\nconst error_message = `[${workflowName}] node \"${lastNode}\": ${baseMessage}`;\n\n// 4. Собираем лог для таблицы\nconst log = {\n  email,\n  company,\n  priority,\n  classification,\n  source,\n  budget,\n  urgency,\n  use_case,\n\n  contact_id,\n  deal_id,\n\n  step: 'error',\n  status: 'error',\n  error_message,\n  raw_execution: exec.id || null,\n\n  // Метаданные для Slack / дебага\n  meta: {\n    workflow_id: wf.id || null,\n    workflow_name: workflowName,\n    last_node: lastNode,\n    execution_id: exec.id || null,\n    execution_url: exec.url || null,\n  },\n};\n\nreturn [{ json: log }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
